# =============================================================================
# KAIROS — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env.local
.env.production
.env.staging
# Keep .env.example (template), ignore actual .env
.env
!.env.example

# --- ML model cache ---
.cache/
*.onnx
*.pt
*.pth
*.bin
*.safetensors
/backend/.cache/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc
.tox/

# --- Type checking ---
.mypy_cache/
.dmypy.json
.pytype/

# --- Linting ---
.ruff_cache/

# --- Go ---
/backend/connectors/vendor/
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# --- Node / Next.js (frontend — future) ---
node_modules/
.next/
out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.pnp.*

# --- Docker ---
# docker-compose.yml (prod base) and docker-compose.override.yml (dev) are BOTH
# tracked — the override is the reproducible dev config, not a local secret file.
# Personal, machine-local overrides go in docker-compose.local.yml (ignored).
docker-compose.local.yml

# --- Database ---
# Local Neo4j data (managed by Docker volumes, not tracked)
/data/neo4j/
/data/qdrant/
/data/elasticsearch/
/data/redis/
/data/temporal/

# --- IDE / OS ---
.DS_Store
.DS_Store?

# Demo video (47 MB). Deliverables in demo/ are committed EXCEPT the video — a binary that
# size lives in git history permanently and every clone pays for it. Share it via the
# submission portal / a release asset, or track it with Git LFS if it must be in-repo.
demo/*.mp4
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# --- Secrets / Keys ---
*.pem
*.key
*.p12
*.pfx
vault-data/
vault.json
# HashiCorp Vault dev data
/vault/data/

# --- Logs ---
*.log
logs/
/backend/logs/

# --- Uploads / Temp ---
/tmp/
/uploads/
*.tmp

# --- Grafana state ---
/backend/grafana/data/

# --- OpenTelemetry ---
# Config is tracked, data is not
/backend/otel/data/

# --- Temporal ---
# Dynamic config is tracked, local state is not
/backend/temporal/data/

# --- Documentation builds ---
/docs/_build/
/docs/site/

# --- Jupyter (if used for data exploration) ---
.ipynb_checkpoints/
*.ipynb

# --- HuggingFace downloads ---
/backend/.cache/huggingface/

# Local .env backups (may contain secrets)
.env.bak.*
