# =============================================================================
# KAIROS — Environment Variables
# Copy this to .env and fill in the blanks for cloud services.
# Local Docker service defaults are pre-filled.
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# =============================================================================
# STORAGE — Supabase (Cloud)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=kairos-vault

# =============================================================================
# GRAPH — Neo4j (Local Docker)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kairos_dev_password
NEO4J_DATABASE=neo4j

# =============================================================================
# VECTOR STORE — Qdrant (Local Docker)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_KNOWLEDGE=kairos_knowledge
QDRANT_COLLECTION_DOCUMENTS=kairos_documents

# =============================================================================
# SEARCH — Elasticsearch (Local Docker)
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_ASSETS=kairos_assets
ELASTICSEARCH_INDEX_DOCUMENTS=kairos_documents
ELASTICSEARCH_INDEX_EVENTS=kairos_events

# =============================================================================
# CACHE + EVENT BUS — Redis (Local Docker)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
REDIS_DB_STREAMS=2
REDIS_STREAM_WORK_ORDERS=kairos:events:work_orders
REDIS_STREAM_PTW=kairos:events:ptw
REDIS_STREAM_SHIFT_HANDOVER=kairos:events:shift_handover
REDIS_STREAM_ALARMS=kairos:events:alarms
REDIS_STREAM_BRIEFS=kairos:events:briefs

# =============================================================================
# AI — NVIDIA NIM (Cloud — used for LLM synthesis only)
# =============================================================================
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_MAX_TOKENS=4096
NVIDIA_NIM_TEMPERATURE=0.1

# =============================================================================
# AI — Jina AI (Cloud — embeddings, keeps NIM free for synthesis)
# =============================================================================
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_URL=https://api.jina.ai/v1/embeddings

# =============================================================================
# AI — Embeddings
# =============================================================================
EMBEDDING_DIMENSION=1024

# =============================================================================
# AI — Groq (Cloud — Whisper transcription via whisper-large-v3)
# =============================================================================
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# =============================================================================
# AI — Ollama (Local — fallback for offline / air-gapped deployments)
# Note: inside Docker containers use http://host.docker.internal:11434
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# =============================================================================
# ML — HuggingFace Models
# =============================================================================
HF_MODEL_NER=xlm-roberta-large
HF_MODEL_CLASSIFIER=bert-base-multilingual-cased
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=

# =============================================================================
# ASYNC TASKS — Celery
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_CONCURRENCY=4

# =============================================================================
# DURABLE WORKFLOWS — Temporal.io (Local Docker)
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kairos-ingestion
TEMPORAL_TASK_QUEUE_ELICITATION=kairos-elicitation

# =============================================================================
# GOVERNANCE — Open Policy Agent (Local Docker)
# =============================================================================
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/policies/kairos.rego

# =============================================================================
# SECRETS — HashiCorp Vault (Local Docker, dev mode)
# =============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=kairos-dev-root-token
VAULT_MOUNT_PATH=kairos
VAULT_DEV_ROOT_TOKEN=kairos-dev-root-token

# =============================================================================
# OBSERVABILITY — OpenTelemetry + Grafana (Local Docker)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kairos-api
OTEL_SERVICE_VERSION=0.1.0
GRAFANA_ADMIN_PASSWORD=kairos_dev_password

# =============================================================================
# OT FEDERATION — Historian Connectors (Go service)
# =============================================================================
GO_CONNECTOR_PORT=8090
PI_WEBAPI_BASE_URL=
PI_WEBAPI_USERNAME=
PI_WEBAPI_PASSWORD=
OPCUA_ENDPOINT_URL=
HISTORIAN_QUERY_TIMEOUT_SECONDS=30

# =============================================================================
# EEMUA 191 — Push Governor
# =============================================================================
MAX_PUSH_PER_USER_PER_HOUR=6
BRIEF_COOLDOWN_HOURS=4
DEDUP_WINDOW_MINUTES=10
LATE_ARRIVAL_WINDOW_MINUTES=5
