# =============================================================================
# KAIROS — .dockerignore
# Excludes files from Docker build context for faster builds + no secret leakage
# =============================================================================

# --- Git ---
.git/
.gitignore

# --- Python artifacts ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- ML model cache (large — pull separately) ---
.cache/
*.onnx
*.pt
*.pth
*.bin
*.safetensors

# --- Secrets ---
.env
.env.local
*.pem
*.key

# --- Node / Frontend (not needed in backend image) ---
frontend/
node_modules/
.next/

# --- Local data (Docker volumes manage this) ---
data/
logs/
tmp/
uploads/
vault/

# --- Go vendor (if present) ---
backend/connectors/vendor/

# --- IDE / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*.log

# --- Docs ---
docs/

# --- Tests (exclude from prod image if desired) ---
# Comment out next line to include tests in the image
# backend/tests/
